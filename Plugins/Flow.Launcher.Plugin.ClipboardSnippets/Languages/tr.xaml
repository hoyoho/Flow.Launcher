<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_name">Pano parçaları</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_description">Kayıtlı içeriği hızlıca panoya doldurur</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_subtitle">Panoya kopyala: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_empty_subtitle">Bu boş parçayı kopyalamak için Enter’a basın</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copied_notification">“{0}” panoya kopyalandı.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_failed">Panoya kopyalanamadı. Pano başka bir uygulama tarafından kullanılıyor olabilir. Lütfen tekrar deneyin.</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_notify_label">Başarılı kopyalamadan sonra bildirim göster</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title">Başlık</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content">İçerik</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add">Ekle</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_delete">Sil</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_ok">Tamam</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_cancel">İptal</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add_snippet_title">Parça ekle</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_edit_snippet_title">Parçayı düzenle</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title_empty_error">Başlık boş olamaz.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content_empty_error">İçerik boş olamaz.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_select_delete_error">Önce silinecek bir parça seçin.</system:String>

</ResourceDictionary>
