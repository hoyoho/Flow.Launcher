<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_name">Исечци клипборда</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_description">Брзо попуњава клипборд унетим садржајем</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_subtitle">Копирај у клипборд: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_empty_subtitle">Притисните Enter да копирате овај празан исечак</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copied_notification">„{0}“ је копиран у клипборд.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_failed">Копирање у клипборд није успело. Клипборд можда користи друга апликација. Покушајте поново.</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_notify_label">Прикажи обавештење након успешног копирања</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title">Наслов</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content">Садржај</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add">Додај</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_delete">Обриши</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_ok">У реду</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_cancel">Откажи</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add_snippet_title">Додај исечак</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_edit_snippet_title">Измени исечак</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title_empty_error">Наслов не може бити празан.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content_empty_error">Садржај не може бити празан.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_select_delete_error">Прво изаберите исечак за брисање.</system:String>

</ResourceDictionary>
