<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_name">Utklippstavle-snutter</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_description">Fyller raskt utklippstavlen med innholdet du har lagt inn</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_subtitle">Kopier til utklippstavlen: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_empty_subtitle">Trykk Enter for å kopiere denne tomme snutten</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copied_notification">„{0}“ kopiert til utklippstavlen.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_failed">Kunne ikke kopiere til utklippstavlen. Den kan være i bruk av et annet program. Prøv igjen.</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_notify_label">Vis varsel etter vellykket kopiering</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title">Tittel</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content">Innhold</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add">Legg til</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_delete">Slett</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_ok">OK</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_cancel">Avbryt</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add_snippet_title">Legg til snutt</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_edit_snippet_title">Rediger snutt</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title_empty_error">Tittelen kan ikke være tom.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content_empty_error">Innholdet kan ikke være tomt.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_select_delete_error">Velg en snutt å slette først.</system:String>

</ResourceDictionary>
