<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_name">Zwischenablage-Snippets</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_description">Füllt die Zwischenablage schnell mit Ihren vorgegebenen Inhalten</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_subtitle">In die Zwischenablage kopieren: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_empty_subtitle">Drücken Sie Enter, um dieses leere Snippet zu kopieren</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copied_notification">„{0}“ wurde in die Zwischenablage kopiert.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_failed">Kopieren in die Zwischenablage fehlgeschlagen. Die Zwischenablage wird möglicherweise von einer anderen Anwendung verwendet. Bitte versuchen Sie es erneut.</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_notify_label">Nach erfolgreichem Kopieren eine Benachrichtigung anzeigen</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title">Titel</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content">Inhalt</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add">Hinzufügen</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_delete">Löschen</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_ok">OK</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_cancel">Abbrechen</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add_snippet_title">Snippet hinzufügen</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_edit_snippet_title">Snippet bearbeiten</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title_empty_error">Der Titel darf nicht leer sein.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content_empty_error">Der Inhalt darf nicht leer sein.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_select_delete_error">Wählen Sie zuerst ein zu löschendes Snippet aus.</system:String>

</ResourceDictionary>
