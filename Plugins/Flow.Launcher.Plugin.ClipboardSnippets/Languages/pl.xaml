<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_name">Fragmenty schowka</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_description">Szybko wypełnia schowek zapisaną treścią</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_subtitle">Kopiuj do schowka: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_empty_subtitle">Naciśnij Enter, aby skopiować ten pusty fragment</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copied_notification">„{0}” skopiowano do schowka.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_failed">Nie udało się skopiować do schowka. Schowek może być używany przez inną aplikację. Spróbuj ponownie.</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_notify_label">Pokazuj powiadomienie po udanym kopiowaniu</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title">Tytuł</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content">Treść</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add">Dodaj</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_delete">Usuń</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_ok">OK</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_cancel">Anuluj</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add_snippet_title">Dodaj fragment</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_edit_snippet_title">Edytuj fragment</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title_empty_error">Tytuł nie może być pusty.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content_empty_error">Treść nie może być pusta.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_select_delete_error">Najpierw wybierz fragment do usunięcia.</system:String>

</ResourceDictionary>
