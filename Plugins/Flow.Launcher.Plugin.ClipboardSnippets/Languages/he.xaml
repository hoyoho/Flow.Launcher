<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_name">קטעי לוח</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_description">ממלא במהירות את לוח הגזירים בתוכן שהזנת</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_subtitle">העתקה ללוח: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_empty_subtitle">לחץ Enter כדי להעתיק קטע ריק זה</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copied_notification">“{0}” הועתק ללוח.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_failed">ההעתקה ללוח נכשלה. ייתכן שהלוח בשימוש על ידי יישום אחר. נסה שוב.</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_notify_label">הצג התראה לאחר העתקה מוצלחת</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title">כותרת</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content">תוכן</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add">הוסף</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_delete">מחק</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_ok">אישור</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_cancel">ביטול</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add_snippet_title">הוסף קטע</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_edit_snippet_title">ערוך קטע</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title_empty_error">הכותרת לא יכולה להיות ריקה.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content_empty_error">התוכן לא יכול להיות ריק.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_select_delete_error">בחר קודם קטע למחיקה.</system:String>

</ResourceDictionary>
