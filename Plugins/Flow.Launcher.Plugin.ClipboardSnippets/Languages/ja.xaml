<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_name">クリップボードスニペット</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_description">登録した内容をすばやくクリップボードへ入力します</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_subtitle">クリップボードにコピー：{0}</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_empty_subtitle">Enter を押してこの空のスニペットをコピー</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copied_notification">「{0}」をクリップボードにコピーしました。</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_failed">クリップボードへのコピーに失敗しました。他のアプリケーションがクリップボードを使用している可能性があります。もう一度お試しください。</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_notify_label">コピー成功時に通知を表示する</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title">タイトル</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content">内容</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add">追加</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_delete">削除</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_ok">OK</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_cancel">キャンセル</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add_snippet_title">スニペットを追加</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_edit_snippet_title">スニペットを編集</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title_empty_error">タイトルを入力してください。</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content_empty_error">内容を入力してください。</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_select_delete_error">削除するスニペットを先に選択してください。</system:String>

</ResourceDictionary>
