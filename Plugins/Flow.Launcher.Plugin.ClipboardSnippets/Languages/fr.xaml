<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_name">Extraits du presse-papiers</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_description">Remplit rapidement le presse-papiers avec le contenu que vous avez enregistré</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_subtitle">Copier dans le presse-papiers : {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_empty_subtitle">Appuyez sur Entrée pour copier cet extrait vide</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copied_notification">« {0} » a été copié dans le presse-papiers.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_failed">Impossible de copier dans le presse-papiers. Il est peut-être utilisé par une autre application. Veuillez réessayer.</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_notify_label">Afficher une notification après une copie réussie</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title">Titre</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content">Contenu</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add">Ajouter</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_delete">Supprimer</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_ok">OK</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_cancel">Annuler</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add_snippet_title">Ajouter un extrait</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_edit_snippet_title">Modifier l'extrait</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title_empty_error">Le titre ne peut pas être vide.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content_empty_error">Le contenu ne peut pas être vide.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_select_delete_error">Sélectionnez d'abord un extrait à supprimer.</system:String>

</ResourceDictionary>
