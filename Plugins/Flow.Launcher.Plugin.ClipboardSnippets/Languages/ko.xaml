<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_name">클립보드 스니펫</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_plugin_description">입력한 내용을 빠르게 클립보드에 채웁니다</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_subtitle">클립보드에 복사: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_empty_subtitle">Enter 키를 눌러 이 빈 스니펫을 복사</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copied_notification">“{0}”이(가) 클립보드에 복사되었습니다.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_copy_failed">클립보드에 복사하지 못했습니다. 다른 응용 프로그램이 클립보드를 사용 중일 수 있습니다. 다시 시도해 주세요.</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_notify_label">복사 성공 시 알림 표시</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title">제목</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content">내용</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add">추가</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_delete">삭제</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_ok">확인</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_cancel">취소</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_add_snippet_title">스니펫 추가</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_edit_snippet_title">스니펫 편집</system:String>

    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_title_empty_error">제목은 비워 둘 수 없습니다.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_content_empty_error">내용은 비워 둘 수 없습니다.</system:String>
    <system:String x:Key="flowlauncher_plugin_clipboardsnippets_select_delete_error">삭제할 스니펫을 먼저 선택하세요.</system:String>

</ResourceDictionary>
