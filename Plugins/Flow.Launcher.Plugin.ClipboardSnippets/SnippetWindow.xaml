<Window
    x:Class="Flow.Launcher.Plugin.ClipboardSnippets.SnippetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Snippet"
    Width="500"
    SizeToContent="Height"
    Background="{DynamicResource PopuBGColor}"
    Foreground="{DynamicResource PopupTextColor}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <StackPanel Margin="26,20,26,0">
            <TextBlock Text="{DynamicResource flowlauncher_plugin_clipboardsnippets_title}" />
            <TextBox
                x:Name="TitleBox"
                Height="30"
                Margin="0,4,0,14"
                Padding="6,4" />

            <TextBlock Text="{DynamicResource flowlauncher_plugin_clipboardsnippets_content}" />
            <TextBox
                x:Name="ContentBox"
                Height="160"
                Margin="0,4,0,0"
                Padding="6,4"
                AcceptsReturn="True"
                AcceptsTab="True"
                VerticalScrollBarVisibility="Auto"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="StatusText"
                Margin="0,10,0,0"
                Foreground="#E81123"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,16,0,0"
            Background="{DynamicResource PopupButtonAreaBGColor}"
            BorderBrush="{DynamicResource PopupButtonAreaBorderColor}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    MinWidth="140"
                    Margin="10,0,5,0"
                    Click="CancelButton_OnClick"
                    Content="{DynamicResource flowlauncher_plugin_clipboardsnippets_cancel}"
                    IsCancel="True" />
                <Button
                    MinWidth="140"
                    Margin="5,0,10,0"
                    Click="OkButton_OnClick"
                    Content="{DynamicResource flowlauncher_plugin_clipboardsnippets_ok}"
                    IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
